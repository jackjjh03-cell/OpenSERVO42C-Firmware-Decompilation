{
  "version": 4,
  "configurations": [
    {
      "name": "SERVO42C (HC32L130)",
      "compilerPath": "clang",
      "compilerArgs": [
        "--target=arm-none-eabi",
        "-mcpu=cortex-m0plus",
        "-mthumb"
      ],
      "includePath": [
        "${workspaceFolder}/factory/include"
      ],
      "compileCommands": "${workspaceFolder}/build/factory/compile_commands.json",
      "cStandard": "c11",
      "intelliSenseMode": "${default}"
    }
  ]
}
